# Copy to .env to override the defaults used by docker-compose.yml and scripts/*.sh.
# Local development credentials only - never reuse these anywhere real.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel_local_only
POSTGRES_DB=hotel_db
POSTGRES_PORT=5432

# Number of seeded bookings (brief minimum: 100). Applied only when the volume is first created.
SEED_BOOKINGS=50000

# backup.sh retention (newest N dumps kept); restore.sh target database.
BACKUP_KEEP=7
RESTORE_DB=hotel_db_restore
